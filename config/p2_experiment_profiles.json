{
  "version": "1.0",
  "frozen_at": "2026-07-16",
  "stages": {
    "smoke": {
      "n_environments_per_condition": 50,
      "description": "验证正确性、异常率和数量级",
      "pass_criteria": {
        "crash_rate_max": 0.1,
        "p_value_in_range_rate_min": 0.95,
        "mean_runtime_seconds_max": 5.0
      }
    },
    "pilot": {
      "n_environments_per_condition": 200,
      "description": "淘汰明显反保守、明显零功效或运行失败的候选",
      "elimination_rules": {
        "null_fdr_max": 0.20,
        "nonnull_recall_min": 0.10,
        "crash_rate_max": 0.05
      }
    },
    "calibration": {
      "n_environments_per_condition": 1000,
      "description": "对剩余候选估计 FDR/Recall/运行成本",
      "selection_metrics": ["null_fdr", "nonnull_recall", "runtime_seconds", "crash_rate"]
    },
    "frozen_null": {
      "n_environments_per_condition": 5000,
      "description": "仅冻结的 1 个主方法和 1 个敏感性方法",
      "gate_thresholds": {
        "bh_fdr_ci_high_max": 0.12,
        "by_fdr_ci_high_max": 0.10
      }
    }
  },
  "conditions": {
    "n_values": [8, 16, 32, 64],
    "structures": ["independent", "dag"],
    "noise_types": ["gaussian", "heteroscedastic", "t5", "outlier"],
    "s_values_for_null": [0],
    "s_values_for_nonnull": [1, 3, 5]
  },
  "candidate_methods": ["A0", "A1", "A2", "A3", "A4", "A5"],
  "bootstrap_grid": [199, 499, 999],
  "frozen_method_slots": {
    "main": 1,
    "sensitivity": 1
  },
  "freezing_priority": [
    "排除存在明显反保守 null 条件的方法",
    "在合格方法中最大化最差条件 Recall CI low",
    "tie-break: 较低 catastrophic failure rate → 较短运行时间 → 较少 bootstrap 次数"
  ],
  "no_method_qualified_label": "NO_METHOD_QUALIFIED"
}
